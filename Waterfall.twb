      <aliases enabled='yes' />
      <column caption='Dimension Field' datatype='string' name='[Calculation_1620451500961611776]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#13;&#10;WHEN &quot;Main Category&quot; THEN [main_category]&#13;&#10;WHEN &quot;Category&quot; THEN [category]&#13;&#10;WHEN &quot;State&quot; THEN [state]&#13;&#10;END' />
      </column>
      <column caption='Measure Field' datatype='real' name='[Calculation_1620451500962443266]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#13;&#10;WHEN &quot;Pledged&quot; THEN SUM([pledged])&#13;&#10;WHEN &quot;Backers&quot; THEN SUM([backers])&#13;&#10;END' />
      </column>
      <column datatype='integer' name='[ID]' role='dimension' type='ordinal' />
      <column caption='Entertainment' datatype='string' name='[Main Category (group)]' role='dimension' type='nominal'>
        <calculation class='categorical-bin' column='[main_category]' new-bin='true'>
          <bin default-name='false' value='&quot;Entertainment&quot;'>
            <value>&quot;Film &amp; Video&quot;</value>
            <value>&quot;Games&quot;</value>
            <value>&quot;Music&quot;</value>
          </bin>
        </calculation>
      </column>
      <column caption='ks-projects-201801.csv' datatype='table' name='[__tableau_internal_object_id__].[ks-projects-201801.csv_30EB4C13AFF84F0AAD20A5EEF862FF4E]' role='measure' type='quantitative' />
      <column caption='Backers' datatype='integer' name='[backers]' role='measure' type='quantitative' />
      <column caption='Category' datatype='string' name='[category]' role='dimension' type='nominal' />
      <column caption='Country' datatype='string' name='[country]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
